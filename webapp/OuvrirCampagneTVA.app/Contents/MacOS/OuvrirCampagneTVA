#!/bin/bash
# Version 0.1 -- localise puis lance webapp/serveur.py.
#
# Meme contrainte que LancerCampagneTVA.app : ce bundle doit vivre hors du
# dossier pCloud pour etre executable (pCloud ne conserve pas le bit
# executable), donc il ne peut pas deriver le chemin du depot de sa propre
# position. Le chemin est mis en cache dans ~/.campagne_tva_depot -- le
# meme fichier que l'autre lanceur, puisque c'est le meme depot.
#
# Tout ce qui suit est journalise dans ~/campagne_tva_web.log, y compris la
# sortie de python3 : lance via Finder, ce script n'a aucun terminal pour
# afficher une erreur, donc c'est le seul moyen de voir ce qui se passe.
LOG="$HOME/campagne_tva_web.log"
{
echo "=== $(date) ==="
echo "PID=$$  PPID=$PPID  PATH=$PATH"

CACHE="$HOME/.campagne_tva_depot"
CANDIDAT_PAR_DEFAUT="$HOME/pCloud Drive/pCloud Backup/MacBookAirdeThomas/Documents/Claude setup/Workflows/VAT/_TEMPLATE-ANNEXES-TVA"

DIR=""
if [ -f "$CACHE" ]; then
    DIR="$(cat "$CACHE")"
    echo "Cache lu : $DIR"
fi
if [ ! -f "$DIR/webapp/serveur.py" ] && [ -f "$CANDIDAT_PAR_DEFAUT/webapp/serveur.py" ]; then
    DIR="$CANDIDAT_PAR_DEFAUT"
    echo "Repli sur le candidat par defaut : $DIR"
fi
if [ ! -f "$DIR/webapp/serveur.py" ]; then
    echo "Ni cache ni candidat par defaut valides -- ouverture du selecteur"
    DIR="$(osascript -e 'POSIX path of (choose folder with prompt "Localiser le dossier _TEMPLATE-ANNEXES-TVA")' 2>>"$LOG")"
    DIR="${DIR%/}"
fi
if [ ! -f "$DIR/webapp/serveur.py" ]; then
    echo "ECHEC : webapp/serveur.py introuvable dans '$DIR'"
    osascript -e 'display alert "Dossier introuvable" message "webapp/serveur.py introuvable dans le dossier choisi." as critical'
    exit 1
fi
printf '%s' "$DIR" > "$CACHE"
echo "DIR retenu : $DIR"
cd "$DIR" || { echo "ECHEC : cd '$DIR'"; exit 1; }
echo "Lancement de python3..."
# Lance par Finder, le PATH se reduit a /usr/bin:/bin:/usr/sbin:/sbin --
# Homebrew en est absent, donc pdftotext (poppler) reste introuvable et
# annexes_tva.py classe alors TOUTES les factures en "scan", meme les PDF
# natifs. On remet les emplacements Homebrew devant.
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
echo "PATH corrige : $PATH"

# --- Verification "Acces complet au disque" ---------------------------
#
# macOS applique TCC au binaire REELLEMENT execute, pas au bundle .app :
# ce script se remplace par python3 via exec, donc c'est python3 qui doit
# figurer dans Reglages > Confidentialite > Acces complet au disque pour
# lire le depot sur pCloud. Sans ca, python3 sort en "Operation not
# permitted" -- l'app se ferme aussitot, sans fenetre, et le seul indice
# est ce journal. On teste donc la lecture AVANT d'exec, et on nomme le
# binaire exact a autoriser (l'entree de PATH est souvent un lien
# symbolique ; le panneau des Reglages, lui, veut la cible reelle).
# Choisir un python3 qui porte REELLEMENT les dependances.
#
# Installer un paquet Homebrew (ocrmypdf, par exemple) peut tirer un
# python@3.x qui se place en tete du PATH et masque celui ou pyyaml et
# openpyxl sont installes. Prendre aveuglement le premier python3 venu
# faisait alors echouer le demarrage -- sans message, puisque l'app n'a
# ni terminal ni fenetre. On teste donc les candidats.
PY=""
for CANDIDAT in "$(command -v python3)" /usr/bin/python3 /opt/homebrew/bin/python3 /usr/local/bin/python3; do
    [ -x "$CANDIDAT" ] || continue
    if "$CANDIDAT" -c "import yaml, openpyxl" 2>/dev/null; then
        PY="$CANDIDAT"; break
    fi
done
if [ -z "$PY" ]; then
    # Aucun ne convient : on garde le premier, et ensure_dependencies
    # proposera l'installation en expliquant ce qui manque.
    PY="$(command -v python3)"
    echo "AVERTISSEMENT : aucun python3 ne porte pyyaml + openpyxl"
fi
echo "python3 retenu : $PY ($("$PY" -V 2>&1))"
if ! "$PY" -c "open(__import__('sys').argv[1]).read(1)" "$DIR/webapp/serveur.py" 2>/dev/null; then
    REEL="$("$PY" -c 'import sys;print(sys.executable)' 2>/dev/null || echo "$PY")"
    echo "ECHEC : $REEL ne peut pas lire le depot (TCC)"
    osascript <<OSA
display alert "Accès au disque refusé" message "python3 n'a pas le droit de lire le dossier du dépôt (il est sur pCloud).

Ouvre Réglages Système > Confidentialité et sécurité > Accès complet au disque, ajoute ce binaire avec le bouton +, puis active-le :

$REEL

Dans la fenêtre de choix, fais Cmd+Maj+G et colle ce chemin. Relance ensuite l'application." as critical
OSA
    exit 1
fi
echo "Lecture du depot OK -- demarrage"
exec /usr/bin/env PYTHONUNBUFFERED=1 "$PY" "$DIR/webapp/serveur.py"
} >> "$LOG" 2>&1
